{
  "name": "@peerly/fe",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:ct": "cypress run --component",
    "test:ct:open": "cypress open --component",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "knip": "knip",
    "jscpd": "jscpd src --ignore '**/*.test.ts,**/*.test.tsx,**/*.stories.ts,**/*.stories.tsx,**/*.d.ts' --min-tokens 70 --min-lines 5 --threshold 2 --reporters console",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run jscpd && npm test && npm run test:ct"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-slot": "1.1.2",
    "@sentry/react": "^10.46.0",
    "@tanstack/react-query": "^5.95.2",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "i18next": "^25.8.18",
    "lucide-react": "0.487.0",
    "next-themes": "0.4.6",
    "react-hook-form": "7.55.0",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^7.13.2",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "9.1.20",
    "@storybook/react-vite": "9.1.20",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "cypress": "^14.5.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-storybook": "9.1.20",
    "husky": "^9.1.7",
    "jscpd": "^4.2.4",
    "jsdom": "^27.0.1",
    "knip": "^6.15.0",
    "lint-staged": "^16.3.0",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "9.1.20",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
